{
  "files": [],
  "compilerOptions": {
   "baseUrl": "src",       // This allows imports starting from 'src'
    "paths": {
      "components/*": ["components/*"],
      "pages/*": ["pages/*"],
      "utils/*": ["utils/*"],
      "types/*": ["types/*"],
      "assets/*": ["assets/*"],
      "hooks/*": ["hooks/*"],
      "data/*": ["data/*"],
      "store/*": ["store/*"],
    }
  },
  "include": ["src"],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
